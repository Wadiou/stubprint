{
  "name": "barcode-options",
  "kind": "steps",
  "note": "height, module width and where the readable text goes. The widths are the dots the printer receives",
  "steps": [
    {
      "op": "initialize"
    },
    {
      "op": "barcode",
      "value": "ABC",
      "symbology": "code128",
      "height": 40,
      "width": 2,
      "text": "below"
    },
    {
      "op": "barcode",
      "value": "ABC",
      "symbology": "code128",
      "height": 80,
      "width": 3,
      "text": "above"
    },
    {
      "op": "barcode",
      "value": "ABC",
      "symbology": "code128",
      "height": 50,
      "width": 4,
      "text": "both"
    },
    {
      "op": "barcode",
      "value": "ABC",
      "symbology": "code128",
      "height": 30,
      "width": 3,
      "text": "none"
    },
    {
      "op": "cut",
      "mode": "full"
    }
  ],
  "expect": {
    "receipts": 1,
    "barcodes": [
      {
        "symbology": "code128",
        "data": "ABC",
        "height": 40,
        "width": 2,
        "text": "below"
      },
      {
        "symbology": "code128",
        "data": "ABC",
        "height": 80,
        "width": 3,
        "text": "above"
      },
      {
        "symbology": "code128",
        "data": "ABC",
        "height": 50,
        "width": 4,
        "text": "both"
      },
      {
        "symbology": "code128",
        "data": "ABC",
        "height": 30,
        "width": 3,
        "text": "none"
      }
    ],
    "cuts": [
      "full"
    ]
  }
}
